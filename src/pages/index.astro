---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import '../styles/global.css';
import { asset, isGif } from '../lib/assets';

const base = import.meta.env.BASE_URL;
const about = (await getEntry('about', 'about'))!;
const { Content: Intro } = await render(about);
const me = about.data;

const pubs = (await getCollection('publications')).map((p) => ({ id: p.id, ...p.data }));
const acts = (await getCollection('activities')).map((a) => ({ id: a.id, ...a.data }));
const projects = (await getCollection('projects')).map((p) => ({ id: p.id, ...p.data }));

// 活动按分组显示，分组顺序以 yaml 里第一次出现的顺序为准
const groups = [...new Set(acts.map((a) => a.group))].map((g) => ({ name: g, items: acts.filter((a) => a.group === g) }));
// Activities 默认只显示这一年及以后的条目，更早的收在 "Show more" 里（年份从 date 里自动识别）
const SHOW_FROM_YEAR = 2022;
const yearOf = (d: string) => Number(d.match(/(19|20)\d{2}/g)?.at(-1) ?? 9999);
const hasOld = acts.some((a) => yearOf(a.date) < SHOW_FROM_YEAR);

// 作者里自己的名字加粗
const authorsHtml = (s: string) =>
  s.split(',').map((a) => a.trim()).map((a) => (a === me.name ? `<b>${a}</b>` : a)).join(', ');
const pdfHref = (pdf: string) => (/^https?:/.test(pdf) ? pdf : `${base}papers/${pdf}`);
const cvHref = me.cv ? (/^https?:/.test(me.cv) ? me.cv : `${base}${me.cv}`) : '';

// 右上角的更新时间：about.md 里写了 updated 就用它，否则自动用发布当月
const now = new Date();
const lastUpdate = me.updated ?? `${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()}`;

const sections = [
  { id: 'about', label: 'About' },
  { id: 'education', label: 'Education' },
  { id: 'works', label: 'Selected Works' },
  { id: 'activities', label: 'Activities' },
  { id: 'designs', label: 'Designs' },
];
const linkLabel = { paper: 'Link', pdf: 'PDF', project: 'Demo', code: 'Code' } as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{me.name}</title>
    <meta name="description" content={`${me.name} — ${me.title ?? ''}`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <!-- 左侧栏 + 内容：作为一个整体在页面里居中 -->
    <div class="page">
    <!-- 左侧栏：头像 → 联系方式 → 菜单 -->
    <aside class="side">
      <div class="avatar">
        <Image src={asset('', me.photo)} alt={me.name} width={320} format="webp" quality={82} loading="eager" />
      </div>
      <ul class="links">
        {me.emails[0] && <li><a href={`mailto:${me.emails[0]}`}><span class="emo">✉️</span>Email me</a></li>}
        {me.scholar && <li><a href={me.scholar} target="_blank" rel="noopener"><span class="emo">🎓</span>Google Scholar</a></li>}
        {me.linkedin && <li><a href={me.linkedin} target="_blank" rel="noopener"><span class="emo">💼</span>LinkedIn</a></li>}
        {cvHref && <li><a href={cvHref} target="_blank" rel="noopener"><span class="emo">📄</span>CV</a></li>}
      </ul>
      <nav class="menu" aria-label="Sections">
        <ol>
          {sections.map((s) => <li><a href={`#${s.id}`} data-menu={s.id}>{s.label}</a></li>)}
        </ol>
      </nav>
    </aside>

    <!-- 手机：右上角的菜单按钮 -->
    <button type="button" class="menu-btn" data-menu-open>Menu</button>

    <main>
      <p class="updated muted">Last updated {lastUpdate}</p>

      <!-- About -->
      <section id="about" class="sec" data-sec>
        <h1 class="reveal">🌈 Hi, I'm {me.name}（王琦鑫）</h1>
        {me.title && <p class="role muted reveal">{me.title}</p>}
        <div class="prose reveal"><Intro /></div>
      </section>

      <!-- Education -->
      <section id="education" class="sec" data-sec>
        <h2 class="sec-title">Education</h2>
        <ul class="edu">
          {me.education.map((e) => (
            <li class="reveal">
              <div>
                <b>{e.school}</b>
                <span class="d">{e.degree}</span>
                {e.note && <span class="muted d">{e.note}</span>}
              </div>
              <div class="right muted">
                <span>{e.years}</span>
                {e.place && <span>{e.place}</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- Selected Works -->
      <section id="works" class="sec" data-sec>
        <h2 class="sec-title">Selected Works</h2>
        <ol class="pubs">
          {pubs.map((p) => (
            <li class="pub reveal">
              <div class:list={['thumb', { empty: !p.image }]}>
                {p.image
                  ? <Image src={asset('papers', p.image)} alt="" width={520} format="webp" quality={78} loading="lazy" />
                  : <span class="venue-mark">{p.venue}</span>}
              </div>
              <div class="body">
                <h3>{p.title}</h3>
                <p class="authors" set:html={authorsHtml(p.authors)} />
                <p class="meta">
                  <span class="tag">{p.venue}</span>
                  {p.status && <span class="tag plain">{p.status}</span>}
                </p>
                {Object.keys(p.links).length > 0 && (
                  <p class="plinks">
                    {(Object.keys(linkLabel) as (keyof typeof linkLabel)[]).filter((k) => p.links[k]).map((k) => (
                      <a href={k === 'pdf' ? pdfHref(p.links[k]!) : p.links[k]} target="_blank" rel="noopener">{linkLabel[k]}</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- Activities -->
      <section id="activities" class="sec" data-sec>
        <h2 class="sec-title">Activities</h2>
        <div class="acts-wrap" data-acts>
          {groups.map((g) => (
            <div class="act-group">
              {groups.length > 1 && <h3 class="sub">{g.name}</h3>}
              <ul class="acts">
                {g.items.map((a) => (
                  <li class:list={['reveal', { old: yearOf(a.date) < SHOW_FROM_YEAR }]}><span>{a.title}</span><span class="muted date">{a.date}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {hasOld && <button type="button" class="more" data-more aria-expanded="false">Show more</button>}
      </section>

      <!-- Designs：过去的 HCI 设计作品（数据在 src/content/projects.yaml） -->
      <section id="designs" class="sec" data-sec>
        <h2 class="sec-title">Designs</h2>
        <span id="projects" class="anchor-alias" aria-hidden="true"></span><!-- 旧链接 #projects（简历里用到）也定位到这里 -->
        <ul class="projects">
          {projects.map((p) => (
            <li class="reveal">
              <button type="button" class="card" data-project={p.id}>
                <span class="cover">
                  <Image src={asset('projects', p.cover)} alt="" width={720} format="webp" quality={78} loading="lazy" />
                </span>
                <span class="card-title">{p.title}</span>
                {p.subtitle && <span class="card-sub muted">{p.subtitle}</span>}
              </button>
            </li>
          ))}
        </ul>
      </section>

      <div class="end"></div>
    </main>
    </div>

    <!-- 项目详情弹窗（每个项目一份，默认隐藏） -->
    {projects.map((p) => (
      <div class="modal" data-modal={p.id} hidden>
        <div class="modal-box" role="dialog" aria-modal="true" aria-label={p.title}>
          <div class="modal-head">
            <div>
              <h3>{p.title}</h3>
              {p.subtitle && <p class="muted">{p.subtitle}</p>}
            </div>
            <button type="button" class="close" data-close>Close</button>
          </div>
          {p.description && <p class="modal-desc">{p.description}</p>}
          <div class="modal-imgs">
            {p.images.map((name) =>
              isGif(name)
                ? <img src={`${base}projects/${name}`} alt="" loading="lazy" />
                : <Image src={asset('projects', name)} alt="" widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 860px" format="webp" quality={80} loading="lazy" />,
            )}
          </div>
        </div>
      </div>
    ))}

    <!-- 手机目录 -->
    <div class="sheet" data-sheet hidden>
      <button type="button" class="close sheet-close" data-menu-close>Close</button>
      <ol>
        {sections.map((s) => <li><a href={`#${s.id}`} data-sheet-link>{s.label}</a></li>)}
      </ol>
    </div>

    <script>
      const html = document.documentElement;
      const $$ = <T extends Element = HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)];

      // 进入视口时浮现
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -6% 0px' });
      $$('.reveal').forEach((el) => io.observe(el));

      // 左侧菜单：当前所在的板块高亮
      const spy = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        $$('[data-menu]').forEach((a) => a.classList.toggle('active', a.dataset.menu === (e.target as HTMLElement).id));
      }), { rootMargin: '-40% 0px -55% 0px' });
      $$('[data-sec]').forEach((s) => spy.observe(s));

      // Activities：Show more / Show less
      const more = document.querySelector<HTMLButtonElement>('[data-more]');
      more?.addEventListener('click', () => {
        const wrap = document.querySelector<HTMLElement>('[data-acts]')!;
        const openNow = wrap.classList.toggle('expanded');
        more.textContent = openNow ? 'Show less' : 'Show more';
        more.setAttribute('aria-expanded', String(openNow));
        if (openNow) wrap.querySelectorAll('.old').forEach((el) => el.classList.add('in'));
      });

      // 项目弹窗
      let open: HTMLElement | null = null;
      const close = () => { if (open) { open.hidden = true; open = null; html.classList.remove('lock'); } };
      $$('[data-project]').forEach((b) => b.addEventListener('click', () => {
        open = document.querySelector<HTMLElement>(`[data-modal="${b.dataset.project}"]`)!;
        open.hidden = false;
        open.scrollTop = 0;
        open.querySelector('.modal-head')!.classList.remove('hide');
        html.classList.add('lock');
      }));
      $$('[data-modal]').forEach((m) => {
        m.addEventListener('click', (e) => {
          if (e.target === m || (e.target as HTMLElement).closest('[data-close]')) close();
        });
        // 弹窗里往下看图时收起标题栏，往上滑时出现
        const head = m.querySelector<HTMLElement>('.modal-head')!;
        let last = 0;
        m.addEventListener('scroll', () => {
          const y = m.scrollTop, dy = y - last;
          if (Math.abs(dy) < 6) return;
          head.classList.toggle('hide', dy > 0 && y > 120);
          last = y;
        }, { passive: true });
      });

      // 手机目录
      const sheet = document.querySelector<HTMLElement>('[data-sheet]')!;
      const closeSheet = () => { sheet.hidden = true; html.classList.remove('lock'); };
      document.querySelector('[data-menu-open]')!.addEventListener('click', () => { sheet.hidden = false; html.classList.add('lock'); });
      document.querySelector('[data-menu-close]')!.addEventListener('click', closeSheet);
      $$('[data-sheet-link]').forEach((a) => a.addEventListener('click', closeSheet));

      addEventListener('keydown', (e) => { if (e.key === 'Escape') { close(); closeSheet(); } });
    </script>
  </body>
</html>

<style>
  /* ── 左侧栏 ── */
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .side { position: relative; z-index: 5; padding-top: 48px; }
  @media (min-width: 960px) {
    .side { text-align: right; }
    .side .avatar { margin-left: auto; }
  }
  .avatar { width: 120px; }
  .avatar :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; background: var(--ph); }
  .links { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 4px; font-size: 13px; }
  .links a { color: var(--accent); word-break: break-all; }
  .emo { margin-right: 6px; font-size: 12px; }
  .links a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .menu { display: none; margin-top: 56px; }
  .menu ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .menu a { font-size: 14px; color: var(--soft); transition: color 0.3s; }
  .menu a:hover { color: var(--fg); }
  .menu a { display: inline-flex; align-items: center; gap: 6px; }
  .menu a::after { content: '›'; font-size: 13px; line-height: 1; opacity: 0; transform: translateX(-4px); transition: opacity 0.3s, transform 0.3s; }
  .menu a.active { color: var(--accent); font-weight: 600; }
  .menu a.active::after { opacity: 1; transform: none; }

  .menu-btn {
    position: fixed;
    top: 16px;
    right: var(--gutter);
    z-index: 40;
    padding: 6px 12px;
    font-size: 13px;
    color: var(--soft);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--line);
  }

  main { position: relative; min-width: 0; }
  .updated { margin: 0; padding-top: 24px; text-align: right; font-size: 12px; }

  @media (min-width: 960px) {
    /* 两栏：左侧栏随页面居中，并粘在视野里 */
    .page {
      display: grid;
      /* 左栏宽度 = 内容本身的宽度（不多留空），这样整体在视觉上居中 */
      grid-template-columns: max-content minmax(0, 1fr);
      gap: 52px;
    }
    .side {
      position: sticky;
      z-index: 5;
      top: 0;
      height: 100vh;
      padding-top: 64px;
      overflow-y: auto;
    }
    .menu { display: block; }
    .menu-btn { display: none; }
  }

  /* ── 板块 ── */
  .sec { padding-top: clamp(56px, 9vh, 96px); }
  #about { padding-top: 24px; }
  .sec-title {
    margin: 0 0 28px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 22px;
    font-weight: 600;
  }
  .sub { margin: 36px 0 12px; font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }

  /* About */
  h1 { margin: 0 0 6px; font-size: clamp(26px, 3vw, 34px); font-weight: 600; line-height: 1.3; }
  .role { margin: 0 0 22px; font-size: 14px; }
  .prose :global(p) { margin: 0 0 14px; color: var(--soft); }
  .prose :global(strong) { color: var(--accent); font-weight: 500; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(a:hover) { text-decoration: underline; text-underline-offset: 3px; }

  .edu { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .edu li { display: flex; justify-content: space-between; gap: 20px; }
  .edu b { display: block; }
  .edu .d { display: block; font-size: 14px; color: var(--soft); }
  .edu .d.muted { color: var(--muted); font-size: 13px; }
  .edu .right { display: flex; flex-direction: column; align-items: flex-end; font-size: 13px; white-space: nowrap; }

  /* Selected Works */
  .pubs { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px; }
  .pub { display: grid; grid-template-columns: 190px 1fr; gap: 26px; align-items: start; }
  .thumb { aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg); border: 1px solid var(--line); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .thumb.empty { display: flex; align-items: center; justify-content: center; background: var(--ph); border-color: transparent; }
  .venue-mark { font-size: 13px; font-weight: 600; color: var(--muted); }
  .pub h3 { margin: 0 0 6px; font-size: 16px; font-weight: 600; line-height: 1.45; }
  .authors { margin: 0 0 8px; font-size: 14px; color: var(--soft); }
  .authors :global(b) { color: var(--fg); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 8px; }
  .tag { font-size: 12px; font-weight: 600; padding: 1px 8px; color: var(--accent); background: var(--accent-soft); }
  .tag.plain { font-weight: 400; color: var(--soft); background: var(--ph); }
  .plinks { display: flex; flex-wrap: wrap; gap: 16px; margin: 0; font-size: 13px; }
  .plinks a { color: var(--accent); }
  .plinks a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Activities */
  .act-group:first-of-type .sub { margin-top: 0; }
  .acts { list-style: none; margin: 0; padding: 0; }
  .acts li { display: flex; justify-content: space-between; gap: 24px; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .acts .date { white-space: nowrap; font-size: 13px; }
  .acts-wrap:not(.expanded) .old { display: none; }
  .more {
    margin-top: 16px;
    font-size: 13px;
    color: var(--accent);
  }
  .more:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Projects */
  .projects { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 26px; }
  .card { display: block; width: 100%; text-align: left; }
  .cover { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--ph); }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .card:hover .cover :global(img) { transform: scale(1.03); }
  .card-title { display: block; margin-top: 10px; font-size: 15px; font-weight: 600; }
  .card:hover .card-title { color: var(--accent); }
  .card-sub { display: block; font-size: 13px; line-height: 1.55; }

  .end { height: 120px; } /* 页面底部留白 */

  /* 项目弹窗 */
  .modal { position: fixed; inset: 0; z-index: 80; overflow-y: auto; background: rgba(35, 24, 72, 0.45); padding: 6vh var(--gutter); }
  .modal[hidden] { display: none; }
  .modal-box { max-width: 900px; margin: 0 auto; background: #fff; }
  .modal-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding: 18px 24px;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid var(--line);
  }
  .modal-head { transition: transform 0.4s var(--ease); }
  .modal-head.hide { transform: translateY(calc(-100% - 6vh)); }
  .modal-head h3 { margin: 0; font-size: 18px; font-weight: 600; }
  .modal-head p { margin: 2px 0 0; font-size: 13px; }
  .close { font-size: 13px; color: var(--soft); }
  .close:hover { color: var(--accent); }
  .modal-desc { padding: 20px 24px 0; margin: 0; color: var(--soft); }
  .modal-imgs :global(img) { width: 100%; }

  :global(html.lock) { overflow: hidden; }

  /* 手机目录 */
  .sheet { position: fixed; inset: 0; z-index: 70; background: var(--bg); padding: 80px var(--gutter); }
  .sheet[hidden] { display: none; }
  .sheet-close { position: absolute; top: 20px; right: var(--gutter); }
  .sheet ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; font-size: 22px; font-weight: 600; }

  @media (max-width: 760px) {
    .pub { grid-template-columns: 1fr; gap: 12px; }
    .thumb { max-width: 320px; }
    .projects { grid-template-columns: 1fr; }
    .edu li, .acts li { flex-direction: column; gap: 2px; }
    .edu .right { align-items: flex-start; flex-direction: row; gap: 10px; }
  }
</style>
